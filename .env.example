# Firebase web config — copy to .env.local and fill in from
# Firebase console → Project settings → Your apps → fokus-web.
# These values are public by design; access is enforced by firestore.rules.
#
# Vercel: add these 4 NEXT_PUBLIC_FIREBASE_* variables to the project
# (Settings → Environment Variables). Without them the production build
# will probably fail.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
